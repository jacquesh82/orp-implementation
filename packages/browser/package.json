{
  "name": "@optirelay/browser",
  "version": "0.2.3",
  "description": "ORP browser adapters: getUserMedia camera, Canvas screen rendering, permissions, capability detection.",
  "keywords": [
    "optirelay",
    "orp",
    "optical-relay",
    "camera",
    "webcrypto",
    "optical-data-transfer",
    "screen-to-camera",
    "offline-file-transfer",
    "air-gap"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@optirelay/core": "workspace:^",
    "@optirelay/optical": "workspace:^"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacquesh82/orp-implementation.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "homepage": "https://orp.mindlog.today/",
  "bugs": {
    "url": "https://github.com/jacquesh82/orp-implementation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
