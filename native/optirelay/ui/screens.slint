// The app screens: home (Receive / Send), live reception, code and
// verification, received file, sending choice, transmission. Displayed
// values are properties fed by the Rust engine; the defaults are sample
// values for the off-screen captures.

import { Theme, Icons } from "theme.slint";
import { Icon, Dashed, Rule, Label, Tag, Mark, TopBar, Button, Choice, Progress, Figure, BlockBars, BlockView } from "components.slint";

// ── Home: the two functions ────────────────────────────────────────────────
component ChoiceTile inherits Rectangle {
    in property <string> index;
    in property <string> title;
    in property <string> text;
    in property <string> action;
    in property <string> icon-path;
    in property <bool> primary: false;
    callback click();
    background: zone.pressed ? Theme.panel-2 : Theme.black;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.click(); }
    zone := TouchArea { clicked => { root.click(); } }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            Label { text: root.index; accent: true; vertical-alignment: center; horizontal-stretch: 1; }
            Icon { icon-path: root.icon-path; size: 26px; tint: Theme.accent-text; }
        }
        Text { text: root.title; font-size: 28px; letter-spacing: -0.8px; color: Theme.white; }
        Text { text: root.text; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
        Rectangle { height: 2px; }
        Button { text: root.action; kind: root.primary ? "primary" : "outline"; click => { root.click(); } }
    }
    Dashed { }
}

export component HomeScreen inherits VerticalLayout {
    callback receive();
    callback send();

    Rectangle {
        height: 53px;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            Mark { y: 15.5px; }
            Text { text: "OptiRelay"; font-size: 21px; letter-spacing: -0.7px; color: Theme.white; vertical-alignment: center; horizontal-stretch: 1; }
            Tag { y: 16.5px; text: "ORP V0.2"; }
        }
        Dashed { top: false; left: false; right: false; }
    }
    Rectangle {
        background: @linear-gradient(180deg, #0943a0 0%, #062454 55%, #010101 100%);
        VerticalLayout {
            padding: 20px;
            padding-top: 28px;
            padding-bottom: 26px;
            spacing: 14px;
            HorizontalLayout { alignment: start; Tag { text: "SCREEN TO CAMERA / OFFLINE"; ground: Theme.black; } }
            Text {
                text: "A file from one screen to another camera.";
                font-size: 30px;
                letter-spacing: -1px;
                color: Theme.white;
                wrap: word-wrap;
            }
            Text {
                text: "No network, no account: the file travels as an animated grid, encrypted end to end.";
                font-size: 15px;
                color: #ffffff99;
                wrap: word-wrap;
            }
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 18px;
        spacing: 14px;
        vertical-stretch: 1;
        ChoiceTile {
            index: "01 / RECEIVE";
            title: "Receive";
            text: "Aim the camera at the sender's grid, type the code shown next to it, compare 6 digits.";
            action: "OPEN THE CAMERA";
            icon-path: Icons.camera;
            primary: true;
            click => { root.receive(); }
        }
        ChoiceTile {
            index: "02 / SEND";
            title: "Send";
            text: "Pick a file: this screen shows it as a grid, with a one-time code for the receiver.";
            action: "CHOOSE A FILE";
            icon-path: Icons.screen;
            click => { root.send(); }
        }
        Rectangle { vertical-stretch: 1; }
        Label { text: "AES-GCM / ECDH P-256 / NO TELEMETRY"; font-size: 10px; horizontal-alignment: center; }
    }
}

// ── Live reception (camera) ────────────────────────────────────────────────
export component CaptureScreen inherits Rectangle {
    in property <string> advice: "Framing OK. Hold still.";
    in property <bool> framing-good: true;
    in property <string> code: "976 188";
    in property <float> part: 0.42;
    in property <string> detail: "24.1 KB / 57.4 KB";
    in property <string> frames: "312";
    in property <string> throughput: "1.9 KB/s";
    in property <string> mode-tm: "TM4";
    /// Share of recent R/P pairs that yield no valid frame.
    in property <string> errors: "—";
    in property <image> preview;
    in property <bool> lock: false;
    in property <[BlockView]> blocks: [];
    in property <string> outline: "";
    /// Size of the sensor image, rotated to portrait (reference frame of the outline).
    in property <float> guide-width: 1080;
    in property <float> guide-height: 1920;
    in property <string> sheet-title: "Receiving";
    callback back();
    background: Theme.black;

    VerticalLayout {
        TopBar {
            title: "RECEIVE / CAMERA";
            navigation => { root.back(); }
            if root.code != "": Tag { y: 16.5px; text: "CODE " + root.code; ground: Theme.blue; }
        }
        // Viewfinder: the camera image goes here.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 12px;
            Rectangle {
                background: Theme.panel;
                clip: true;
                property <length> side: min(self.width, self.height) * 0.66;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: cover;
                }
                // Grid outlines, laid over the image as "cover" paints it.
                property <float> scale: max(self.width / 1px / root.guide-width, self.height / 1px / root.guide-height);
                if root.outline != "": Path {
                    width: root.guide-width * parent.scale * 1px;
                    height: root.guide-height * parent.scale * 1px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: root.guide-width;
                    viewbox-height: root.guide-height;
                    commands: root.outline;
                    stroke: root.framing-good ? Theme.ok : Theme.warn;
                    stroke-width: 2px;
                    fill: transparent;
                }
                // No grid seen: the aiming square, dashed.
                if root.outline == "": Rectangle {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 - 30px;
                    width: parent.side;
                    height: parent.side;
                    Dashed { tint: Theme.accent; dash: 8px; gap: 6px; }
                }
                if root.lock: HorizontalLayout {
                    x: 10px;
                    y: 10px;
                    height: 20px;
                    alignment: start;
                    Tag { text: "WHITE BALANCE + EXPOSURE LOCKED"; ground: #010101cc; }
                }
                Rectangle {
                    x: 10px;
                    width: parent.width - 20px;
                    y: parent.height - self.height - 10px;
                    height: advice-text.preferred-height + 20px;
                    background: #010101d9;
                    Rectangle { x: 0; width: 3px; background: root.framing-good ? Theme.ok : Theme.warn; }
                    advice-text := Text {
                        x: 16px;
                        width: parent.width - 28px;
                        text: root.advice;
                        font-size: 14px;
                        color: Theme.white;
                        wrap: word-wrap;
                    }
                }
                Dashed { }
            }
        }
        // Bottom sheet: progress.
        Rectangle {
            height: sheet.preferred-height;
            sheet := VerticalLayout {
                padding: 16px;
                padding-bottom: 20px;
                spacing: 10px;
                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Label { text: "STATUS"; }
                        Text { text: root.sheet-title; font-size: 18px; color: Theme.white; }
                    }
                    Text { text: round(root.part * 100) + "%"; font-size: 26px; font-family: Theme.mono; color: Theme.white; vertical-alignment: bottom; }
                }
                Progress { part: root.part; }
                if root.blocks.length > 1: BlockBars { blocks: root.blocks; control-height: 18px; }
                if root.detail != "": Label { text: root.detail; color: Theme.muted; }
                HorizontalLayout {
                    spacing: 8px;
                    Figure { tag: "FRAMES"; value: root.frames; horizontal-stretch: 1; }
                    Figure { tag: "THROUGHPUT"; value: root.throughput; horizontal-stretch: 1; }
                    Figure { tag: "MODE"; value: root.mode-tm; horizontal-stretch: 1; }
                    Figure { tag: "ERRORS"; value: root.errors; horizontal-stretch: 1; }
                }
            }
            Dashed { bottom: false; left: false; right: false; }
        }
    }
}

// ── Code and verification ──────────────────────────────────────────────────
/// Steps of the Code screen.
export enum CodeStep {
    /// Passphrase path: type the code shown next to the sender's grid.
    type-code,
    /// The typed code is being stretched (PBKDF2).
    checking,
    /// Compare the 6 digits with the sender's.
    compare,
    /// Codes path (ORP v0.2, sender with a camera): show the response grid,
    /// then read the sender's reveal grid.
    response,
}

export component CodeScreen inherits Rectangle {
    in property <CodeStep> step: CodeStep.compare;
    in property <[string]> digits: ["9", "7", "6", "1", "8", "8"];
    in property <string> code-readable: "976 188";
    in property <string> note: "57.4 KB announced.";
    in property <string> error: "";
    in property <image> response;
    in-out property <string> typed-text;
    callback submit(string);
    /// Formats the field as the user types (Rust: orp_transfer::code_as_typed).
    pure callback format-code(string) -> string;
    callback identical();
    callback different();
    callback cancel();
    background: Theme.black;

    VerticalLayout {
        TopBar {
            title: root.step == CodeStep.type-code || root.step == CodeStep.checking ? "RECEIVE / SENDER'S CODE" : "RECEIVE / VERIFY";
            icon-path: Icons.close;
            label: "Cancel";
            navigation => { root.cancel(); }
        }
        VerticalLayout {
            padding: 20px;
            padding-top: 24px;
            spacing: 18px;
            vertical-stretch: 1;
            Label {
                accent: true;
                text: root.step == CodeStep.type-code || root.step == CodeStep.checking ? "01 / TYPE THE CODE"
                    : root.step == CodeStep.response ? "01 / SHOW THIS GRID" : "02 / COMPARE";
            }
            Text {
                text: root.step == CodeStep.type-code || root.step == CodeStep.checking
                    ? "Type the 12-character code shown next to the sender's grid."
                    : root.step == CodeStep.response
                        ? "Show this grid to the sender's camera, then aim at its screen again: its next grid gives the verification code."
                        : "The same 6 digits must appear on the sender. If they differ, someone is in the middle: retype or cancel.";
                font-size: 20px;
                letter-spacing: -0.4px;
                color: Theme.white;
                wrap: word-wrap;
            }
            if root.step == CodeStep.type-code || root.step == CodeStep.checking: Rectangle {
                height: 56px;
                background: Theme.panel;
                typed := TextInput {
                    text <=> root.typed-text;
                    x: 16px;
                    width: parent.width - 32px;
                    vertical-alignment: center;
                    font-size: 22px;
                    font-family: Theme.mono;
                    letter-spacing: 1px;
                    color: Theme.white;
                    single-line: true;
                    input-type: text;
                    // A code, not a word: no correction, no suggestion, capitals.
                    // With Slint's defaults (auto-correct, auto-complete) the
                    // keyboard holds the letters as a COMPOSING word, outside
                    // `text`, until committed — the dashes could not be placed.
                    input-method-hints: { capitalization: CapitalizationMode.characters, auto-correct: false, auto-complete: false };
                    enabled: root.step == CodeStep.type-code;
                    accessible-role: text-input;
                    accessible-label: "Code shown by the sender";
                    accepted => { root.submit(self.text); }
                    // Dashes placed by themselves (XXXX-XXXX-XXXX), cursor kept at the end.
                    // (No `let`: Slint 1.18 generates a moved-value error when a
                    // local string is used twice.)
                    edited => {
                        if (root.format-code(self.text) != self.text) {
                            self.text = root.format-code(self.text);
                            // The cursor is moved AFTER this callback by the
                            // insertion itself (old position + 1, the dash not
                            // counted): it is put at the end once that is done.
                            cursor-to-end.running = true;
                        }
                    }
                }
                cursor-to-end := Timer {
                    interval: 1ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        typed.set-selection-offsets(typed.text.character-count, typed.text.character-count);
                    }
                }
                // Placeholder only while the field is idle: on Android the
                // keyboard's COMPOSING text is not in `text` until committed,
                // so "text is empty" alone left it drawn over the typing.
                if typed.text == "" && !typed.has-focus: Text {
                    x: 16px;
                    text: "XXXX-XXXX-XXXX";
                    font-size: 22px;
                    font-family: Theme.mono;
                    letter-spacing: 1px;
                    color: Theme.gray;
                    vertical-alignment: center;
                }
                Dashed { tint: typed.has-focus ? Theme.accent : Theme.line-strong; }
            }
            if root.step == CodeStep.response: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - 40px, 300px);
                    height: self.width;
                    background: white;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.response;
                        image-fit: contain;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: "Response code for the sender's camera";
                    }
                }
            }
            if root.step == CodeStep.compare: HorizontalLayout {
                alignment: center;
                spacing: 6px;
                accessible-role: text;
                accessible-label: "Verification code " + root.code-readable;
                for digit[i] in root.digits: Rectangle {
                    width: i == 3 ? 62px : 44px;
                    height: 64px;
                    Rectangle {
                        x: i == 3 ? 18px : 0;
                        width: 44px;
                        height: 64px;
                        background: Theme.panel;
                        Text { text: digit; font-size: 34px; font-family: Theme.mono; color: Theme.accent-text; }
                        Dashed { tint: Theme.line-strong; }
                    }
                }
            }
            if root.error != "": HorizontalLayout {
                spacing: 10px;
                Rectangle { width: 3px; background: Theme.bad; }
                Text { text: root.error; font-size: 14px; color: Theme.bad; wrap: word-wrap; horizontal-stretch: 1; }
            }
            if root.note != "": Label { text: root.note; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            if root.step == CodeStep.type-code || root.step == CodeStep.checking: Button {
                text: root.step == CodeStep.checking ? "CHECKING THE CODE..." : "CONTINUE";
                active: root.step == CodeStep.type-code;
                click => { root.submit(root.typed-text); }
            }
            if root.step == CodeStep.response: Button { text: "WAITING FOR THE SENDER'S GRID..."; active: false; icon-path: ""; }
            if root.step == CodeStep.compare: Button { text: "THEY MATCH / RECEIVE"; icon-path: Icons.checked; click => { root.identical(); } }
            if root.step == CodeStep.compare: Button { text: "THEY DIFFER / RETYPE"; kind: "outline"; icon-path: Icons.back; click => { root.different(); } }
        }
    }
}

// ── Received file ──────────────────────────────────────────────────────────
export component ReceivedScreen inherits Rectangle {
    in property <string> name: "photo.jpg";
    in property <string> size: "59.7 KB";
    in property <string> mode-tm: "TM4";
    in property <string> message: "";
    in property <image> preview;
    in property <bool> has-preview: false;
    in property <string> text-preview: "No preview for this file type.";
    callback close();
    callback save();
    callback share();
    callback delete();
    background: Theme.black;

    VerticalLayout {
        TopBar { title: "RECEIVE / FILE"; icon-path: Icons.close; label: "Close"; navigation => { root.close(); } }
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            vertical-stretch: 1;
            Rectangle {
                background: #4cd98a14;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Icon { icon-path: Icons.checked; size: 22px; tint: Theme.ok; thickness: 2px; }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Received and verified"; font-size: 16px; color: Theme.ok; }
                        Text { text: "Fingerprint matches the one announced by the sender."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                Dashed { tint: #4cd98a80; }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 160px;
                background: Theme.panel;
                clip: true;
                if root.has-preview: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: "Preview of " + root.name;
                }
                if !root.has-preview: VerticalLayout {
                    padding: 16px;
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout { alignment: center; Icon { icon-path: Icons.file; size: 36px; tint: Theme.dim; } }
                    Text { text: root.text-preview; font-size: 13px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                }
                Dashed { }
            }
            HorizontalLayout {
                spacing: 12px;
                Figure { tag: "NAME"; value: root.name; horizontal-stretch: 2; }
                Figure { tag: "SIZE"; value: root.size; horizontal-stretch: 1; }
                Figure { tag: "MODE"; value: root.mode-tm; horizontal-stretch: 1; }
            }
            Text {
                text: root.message != "" ? root.message : "The file stays in the app's memory until you save it: nothing is opened or imported automatically.";
                font-size: 13px;
                color: root.message != "" ? Theme.accent-text : Theme.dim;
                wrap: word-wrap;
            }
            Button { text: "SAVE TO DOWNLOADS"; icon-path: Icons.download; click => { root.save(); } }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "SHARE"; kind: "outline"; icon-path: Icons.share; horizontal-stretch: 1; click => { root.share(); } }
                Button { text: "DELETE"; kind: "outline"; icon-path: Icons.trash; horizontal-stretch: 1; click => { root.delete(); } }
            }
        }
    }
}

// ── Send: file and mode ────────────────────────────────────────────────────
export component SendScreen inherits Rectangle {
    in property <string> file-name: "photo.jpg";
    in property <string> file-detail: "59.7 KB / ~4 min on screen";
    in property <bool> file-chosen: true;
    in-out property <int> mode: 0; // 0 TM4, 1 TM8
    callback back();
    callback change-file();
    callback start-transmission();
    background: Theme.black;

    VerticalLayout {
        TopBar { title: "SEND"; navigation => { root.back(); } }
        VerticalLayout {
            padding: 16px;
            padding-top: 20px;
            spacing: 14px;
            vertical-stretch: 1;
            Label { text: "01 / FILE"; accent: true; }
            Rectangle {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Icon { icon-path: Icons.file; size: 26px; tint: Theme.accent-text; }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: root.file-name; font-size: 17px; color: Theme.white; overflow: elide; }
                            Label { text: root.file-detail; color: Theme.muted; }
                        }
                    }
                    Button { text: root.file-chosen ? "CHANGE FILE" : "CHOOSE A FILE"; kind: "outline"; icon-path: Icons.file; control-height: 40px; click => { root.change-file(); } }
                }
                Dashed { }
            }
            Label { text: "02 / OPTICAL MODE"; accent: true; }
            Choice { left-label: "TM4 / ROBUST"; right-label: "TM8 / FAST"; choice <=> root.mode; }
            Text {
                text: root.mode == 0
                    ? "TM4: 4 colours, read by any camera. 250 ms per subframe, like OptiRelay Studio."
                    : "TM8: 8 colours, twice the data per grid; needs a good camera and a steady hand.";
                font-size: 13px;
                color: Theme.dim;
                wrap: word-wrap;
            }
            Rule { }
            HorizontalLayout {
                spacing: 12px;
                Icon { icon-path: Icons.padlock; size: 20px; tint: Theme.accent-text; }
                Text {
                    text: "A one-time 12-character code is drawn for each sending and shown next to the grid. The receiver types it; the frames are encrypted with it (AES-GCM).";
                    font-size: 13px;
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            Rectangle { vertical-stretch: 1; }
            Button {
                text: root.file-chosen ? "START TRANSMITTING" : "CHOOSE A FILE";
                icon-path: root.file-chosen ? Icons.arrow : Icons.file;
                click => { if root.file-chosen { root.start-transmission(); } else { root.change-file(); } }
            }
        }
    }
}

// ── Transmission: the grid, the code as text next to it ───────────────────
export component SendingScreen inherits Rectangle {
    in property <image> grid;
    in property <string> code: "K7QF-M2XP-9CHR";
    in property <string> sas: "976 188";
    in property <string> hud: "";
    callback stop();
    background: Theme.black;

    VerticalLayout {
        TopBar { title: "SEND / TRANSMITTING"; icon-path: Icons.close; label: "Stop transmitting"; navigation => { root.stop(); } }
        // The grid, white, as large as possible.
        Rectangle {
            height: self.width;
            background: white;
            // Scale 1: the grid is rendered at a whole number of physical
            // pixels per module (send.rs) — no resampling, all modules the
            // same width. Shrunk only if it overflows.
            Image {
                width: min(parent.width, root.grid.width * 1phx);
                height: min(parent.height, root.grid.height * 1phx);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.grid;
                image-fit: contain;
                image-rendering: pixelated;
                accessible-role: image;
                accessible-label: "Optical grid being transmitted";
            }
        }
        // The code, as TEXT next to the grid — never inside it.
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            vertical-stretch: 1;
            Label { text: "CODE / TYPE IT ON THE RECEIVER"; accent: true; }
            Text {
                text: root.code;
                font-size: 30px;
                font-family: Theme.mono;
                letter-spacing: 1px;
                color: Theme.white;
                accessible-label: "Code " + root.code;
            }
            Rule { }
            HorizontalLayout {
                spacing: 12px;
                Label { text: "VERIFICATION"; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: root.sas; font-size: 24px; font-family: Theme.mono; color: Theme.accent-text; }
            }
            Label { text: root.hud; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            Button { text: "STOP"; kind: "outline"; icon-path: Icons.close; click => { root.stop(); } }
        }
    }
}
