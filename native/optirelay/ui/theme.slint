    out property <string> camera: "M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0";
    out property <string> screen: "M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4";
    out property <string> back: "M19 12H5M11 6l-6 6 6 6";
    out property <string> close: "M6 6l12 12M18 6L6 18";
    out property <string> checked: "M20 6L9 17l-5-5";
    out property <string> arrow: "M5 12h14M13 6l6 6-6 6";
    out property <string> file: "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5";
    out property <string> download: "M12 4v11M7 10l5 5 5-5M5 20h14";
    out property <string> share: "M12 15V4M7 9l5-5 5 5M5 14v5h14v-5";
    out property <string> trash: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13";
    out property <string> padlock: "M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V7a4 4 0 0 1 8 0v4";
}
