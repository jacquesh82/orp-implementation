// OptiRelay identity, aligned with the showcase (apps/site) and OptiRelay
// Studio: near-black ground, greys, the showcase blue, square corners, thin
// light hairlines, Aspekta for text and IBM Plex Mono for uppercase labels
// and codes. Fonts bundled (OFL, licenses next to them in fonts/): converted
// from the showcase woff2 (apps/site/src/assets), unmodified.

import "fonts/Aspekta-Regular.ttf";
import "fonts/IBMPlexMono-Regular.ttf";

export global Theme {
    // Showcase palette.
    out property <color> black: #010101;
    out property <color> white: #ffffff;
    out property <color> gray: #353535;
    out property <color> muted: #c5c5c5;
    out property <color> dim: #a3a3a3;
    out property <color> blue: #0943a0;
    out property <color> blue-pressed: #062f72;
    out property <color> electric: #0055df;
    /// Accent on black: strokes, fills, progress.
    out property <color> accent: #428fff;
    /// Accent used as text.
    out property <color> accent-text: #85b2ff;
    out property <color> panel: #0b0b0b;
    out property <color> panel-2: #141414;
    /// Hairlines (the showcase draws them dashed: see `Dashed`).
    out property <color> border: #ffffff66;
    out property <color> line: #ffffff40;
    out property <color> line-strong: #ffffff80;
    // Semantic colours (Studio).
    out property <color> ok: #4cd98a;
    out property <color> bad: #ff6363;
    out property <color> warn: #ffd23f;
    out property <string> sans: "Aspekta";
    out property <string> mono: "IBM Plex Mono";
}

// Line icons (viewbox 24).
