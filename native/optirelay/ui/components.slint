// Components in the showcase style: square corners, dashed hairlines,
// uppercase monospace labels, the showcase blue for actions.

import { Theme, Icons } from "theme.slint";

export component Icon inherits Rectangle {
    in property <string> icon-path;
    in property <brush> tint: Theme.white;
    in property <length> size: 24px;
    in property <length> thickness: 1.5px;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-path;
        stroke: root.tint;
        stroke-width: root.thickness;
        fill: transparent;
    }
}

// Dashed hairline frame (Slint has no dashed border): laid over its parent,
// as wide and high as it. Each side can be turned off.
export component Dashed inherits Rectangle {
    in property <color> tint: Theme.border;
    in property <length> dash: 3px;
    in property <length> gap: 3px;
    in property <bool> top: true;
    in property <bool> bottom: true;
    in property <bool> left: true;
    in property <bool> right: true;
    property <int> nh: max(0, floor(self.width / (root.dash + root.gap)) + 1);
    property <int> nv: max(0, floor(self.height / (root.dash + root.gap)) + 1);
    if root.top: Rectangle {
        x: 0;
        y: 0;
        height: 1px;
        clip: true;
        for i in root.nh: Rectangle { x: i * (root.dash + root.gap); width: root.dash; height: 1px; background: root.tint; }
    }
    if root.bottom: Rectangle {
        x: 0;
        y: root.height - 1px;
        height: 1px;
        clip: true;
        for i in root.nh: Rectangle { x: i * (root.dash + root.gap); width: root.dash; height: 1px; background: root.tint; }
    }
    if root.left: Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        clip: true;
        for i in root.nv: Rectangle { y: i * (root.dash + root.gap); width: 1px; height: root.dash; background: root.tint; }
    }
    if root.right: Rectangle {
        x: root.width - 1px;
        y: 0;
        width: 1px;
        clip: true;
        for i in root.nv: Rectangle { y: i * (root.dash + root.gap); width: 1px; height: root.dash; background: root.tint; }
    }
}

// Horizontal dashed rule, for layouts.
export component Rule inherits Rectangle {
    in property <color> tint: Theme.line;
    height: 1px;
    Dashed { tint: root.tint; bottom: false; left: false; right: false; }
}

// Uppercase monospace label (the showcase's `.tag`, `figcaption`).
export component Label inherits Text {
    in property <bool> accent: false;
    font-family: Theme.mono;
    font-size: 11px;
    letter-spacing: 0.4px;
    color: root.accent ? Theme.accent-text : Theme.dim;
}

// Tag on a grey ground ("ORP V0.2").
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ground: Theme.gray;
    in property <color> ink: Theme.white;
    height: 20px;
    width: tag-text.preferred-width + 12px;
    background: root.ground;
    tag-text := Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: 10px;
        color: root.ink;
        vertical-alignment: center;
    }
}

// The OptiRelay mark: three finder squares and a module, as on the showcase.
export component Mark inherits Rectangle {
    in property <length> size: 22px;
    in property <color> tint: Theme.white;
    width: size;
    height: size;
    property <length> cell: (root.size - 4px) / 2;
    Rectangle { x: 0; y: 0; width: parent.cell; height: parent.cell; border-width: 1.5px; border-color: root.tint; }
    Rectangle { x: parent.cell + 4px; y: 0; width: parent.cell; height: parent.cell; border-width: 1.5px; border-color: root.tint; }
    Rectangle { x: 0; y: parent.cell + 4px; width: parent.cell; height: parent.cell; border-width: 1.5px; border-color: root.tint; }
    Rectangle { x: parent.cell + 5px; y: parent.cell + 5px; width: parent.cell - 2px; height: parent.cell - 2px; background: root.tint; }
}

// Square 48 dp icon button (back, close).
export component IconButton inherits Rectangle {
    in property <string> icon-path;
    in property <string> label;
    callback click();
    width: 48px;
    height: 48px;
    background: zone.pressed ? #ffffff1f : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.click(); }
    Icon { icon-path: root.icon-path; size: 22px; }
    zone := TouchArea { clicked => { root.click(); } }
}

// Top bar: back (or close), uppercase title, extras on the right; dashed
// rule underneath, like the showcase header.
export component TopBar inherits Rectangle {
    in property <string> title;
    in property <string> icon-path: Icons.back;
    in property <string> label: "Back";
    callback navigation();
    height: 53px;
    background: Theme.black;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 12px;
        spacing: 6px;
        IconButton { y: 2px; icon-path: root.icon-path; label: root.label; click => { root.navigation(); } }
        Text {
            text: root.title;
            font-family: Theme.mono;
            font-size: 12px;
            letter-spacing: 0.6px;
            color: Theme.white;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
    Dashed { top: false; left: false; right: false; }
}

// Action button (the showcase's `.button`): uppercase mono label, the icon
// in a square cell after a dashed separator. primary: blue; white; outline:
// dashed frame on black.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon-path: Icons.arrow;
    in property <string> kind: "primary"; // primary | white | outline
    in property <bool> active: true;
    in property <length> control-height: 48px;
    callback click();
    height: control-height;
    property <bool> down: zone.pressed && root.active;
    background: !root.active ? Theme.gray
        : root.kind == "primary" ? (root.down ? Theme.white : Theme.blue)
        : root.kind == "white" ? (root.down ? Theme.black : Theme.white)
        : (root.down ? Theme.white : transparent);
    property <color> ink: !root.active ? Theme.dim
        : root.kind == "primary" ? (root.down ? Theme.black : Theme.white)
        : root.kind == "white" ? (root.down ? Theme.white : Theme.blue)
        : (root.down ? Theme.black : Theme.white);
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: active;
    accessible-action-default => { if root.active { root.click(); } }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: 12px;
            letter-spacing: 0.4px;
            color: root.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.icon-path != "": Rectangle {
            width: root.control-height;
            Icon { icon-path: root.icon-path; size: 18px; tint: root.ink; }
            Dashed {
                tint: root.kind == "white" ? Theme.blue : Theme.line-strong;
                top: false;
                bottom: false;
                right: false;
            }
        }
    }
    if root.kind == "outline": Dashed { tint: Theme.line-strong; }
    zone := TouchArea {
        enabled: root.active;
        clicked => { root.click(); }
    }
}

// Two-choice selector (TM4 / TM8): the choice in blue, the other dashed.
export component Choice inherits HorizontalLayout {
    in property <string> left-label;
    in property <string> right-label;
    in-out property <int> choice: 0;
    spacing: 8px;
    height: 44px;
    for label[i] in [root.left-label, root.right-label]: Rectangle {
        property <bool> selected: root.choice == i;
        horizontal-stretch: 1;
        background: selected ? Theme.blue : transparent;
        accessible-role: button;
        accessible-label: label;
        accessible-checked: selected;
        Text {
            text: label;
            font-family: Theme.mono;
            font-size: 12px;
            color: selected ? Theme.white : Theme.muted;
        }
        if !selected: Dashed { tint: Theme.line-strong; }
        TouchArea { clicked => { root.choice = i; } }
    }
}

// Progress bar: square, accent fill on a faint track.
export component Progress inherits Rectangle {
    in property <float> part; // 0..1
    height: 4px;
    background: #ffffff1f;
    accessible-role: progress-indicator;
    accessible-value: round(part * 100) + "%";
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.part, 0, 1);
        background: Theme.accent;
    }
}

// Key figure: uppercase label above, value in monospace.
export component Figure inherits VerticalLayout {
    in property <string> tag;
    in property <string> value;
    spacing: 4px;
    Label { text: root.tag; font-size: 10px; }
    Text { text: root.value; font-size: 15px; font-family: Theme.mono; color: Theme.white; overflow: elide; }
}

// Completeness of a file, block by block: one vertical bar per block,
// green once the block is decoded, accent blue as it fills up.
export struct BlockView {
    part: float,
    complete: bool,
}

export component BlockBars inherits Rectangle {
    in property <[BlockView]> blocks;
    in property <length> control-height: 22px;
    height: control-height;
    HorizontalLayout {
        spacing: root.blocks.length > 24 ? 1px : 3px;
        for b[i] in root.blocks: Rectangle {
            horizontal-stretch: 1;
            background: #ffffff1f;
            clip: true;
            accessible-role: progress-indicator;
            accessible-label: "Block " + (i + 1);
            accessible-value: b.complete ? "complete" : round(b.part * 100) + "%";
            Rectangle {
                y: parent.height * (1 - b.part);
                width: parent.width;
                height: parent.height * b.part;
                background: b.complete ? Theme.ok : Theme.accent;
            }
        }
    }
}
